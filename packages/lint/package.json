{
  "name": "@wide-effect/lint",
  "version": "0.0.1-alpha.0",
  "description": "Reusable ast-grep rules for observability invariants",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Potti1234/wide-effect.git",
    "directory": "packages/lint"
  },
  "files": [
    "dist",
    "rules",
    "rule-tests",
    "sgconfig.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sgconfig.yml": "./sgconfig.yml",
    "./rules/*": "./rules/*",
    "./rule-tests/*": "./rule-tests/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "test": "ast-grep test --config sgconfig.yml --skip-snapshot-tests",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0"
  }
}
