{
  "name": "wide-effect-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "example:check": "bun run --cwd examples/correlated-fullstack typecheck && bun run example:fullstack",
    "example:fullstack": "bun run --cwd examples/correlated-fullstack start",
    "clean": "tsc -b --clean",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings . && bun run typecheck",
    "package:check": "bun run build && bun scripts/package-smoke.ts",
    "test": "bun run build && vitest run",
    "typecheck": "tsc -b --pretty false",
    "check": "bun run format:check && bun run lint && bun run test && bun run package:check && bun run example:check",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "bun run check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@effect/vitest": "4.0.0-rc.108",
    "@types/bun": "^1.3.0",
    "@wide-effect/core": "workspace:*",
    "@wide-effect/effect": "workspace:*",
    "@wide-effect/foldkit": "workspace:*",
    "@wide-effect/lint": "workspace:*",
    "@wide-effect/testing": "workspace:*",
    "effect": "4.0.0-rc.108",
    "foldkit": "0.144.0",
    "oxfmt": "^0.52.0",
    "oxlint": "1.78.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "bun@1.3.14"
}
